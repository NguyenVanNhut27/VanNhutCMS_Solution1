@model IEnumerable<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Món ăn";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0">Danh Sách Món Ăn</h2>
            <p class="text-muted mb-0">Quản lý thực đơn và tình trạng tồn kho</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm Món Mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Hình ảnh</th>
                        <th>Tên Món Ăn</th>
                        <th>Danh mục</th>
                        <th>Giá Bán</th>
                        <th>Tồn Kho</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3" style="width: 60px; height: 60px; object-fit: cover; border: 1px solid #eee;">
                                    }
                                    else
                                    {
                                        <div class="rounded-3 bg-light d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 60px; border: 1px dashed #ccc;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <div class="small text-muted text-truncate" style="max-width: 200px;">@item.Description</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@(item.CategoryProduct?.Name ?? "Chưa phân loại")</span>
                                </td>
                                <td class="fw-bold text-danger">
                                    @item.Price.ToString("N0") đ
                                </td>
                                <td>
                                    @if (item.StockQuantity > 10)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">@item.StockQuantity phần</span>
                                    }
                                    else if (item.StockQuantity > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1"><i class="bi bi-exclamation-triangle me-1"></i>Sắp hết (@item.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1">Hết hàng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Bạn có chắc chắn muốn xóa món này khỏi thực đơn?');">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-egg-fried fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Thực đơn đang trống</h5>
                                <p>Hãy thêm các món ăn mới vào hệ thống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>