@model CMS.Data.Entities.Product
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa Món ăn";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-pencil-square me-2"></i>Cập Nhật Món Ăn</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Tên món ăn <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Danh mục</label>
                                <select asp-for="CategoryProductId" asp-items="ViewBag.CategoryList" class="form-select" required>
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                <input asp-for="Price" type="number" class="form-control text-danger fw-bold" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Số lượng tồn kho</label>
                                <input asp-for="StockQuantity" type="number" class="form-control" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark">Chọn ảnh mới (nếu muốn thay đổi)</label>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <div class="mb-2">
                                        <img src="@Model.ImageUrl" alt="Ảnh hiện tại" style="max-height: 80px;" class="rounded border" />
                                        <small class="d-block text-muted">Ảnh hiện tại</small>
                                    </div>
                                }
                                <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark">Mô tả món ăn</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>

                            <div class="col-md-6 mt-4">
                                <div class="form-check form-switch cursor-pointer">
                                    <input class="form-check-input" type="checkbox" asp-for="IsSale" role="switch" id="switchSale" style="transform: scale(1.3); margin-right: 10px;">
                                    <label class="form-check-label fw-bold text-danger pt-1" for="switchSale">Cho phép áp dụng Khuyến Mãi (Sale)</label>
                                </div>
                            </div>

                            <div class="col-md-6 mt-4">
                                <div class="form-check form-switch cursor-pointer">
                                    <input class="form-check-input" type="checkbox" asp-for="IsNew" role="switch" id="switchNew" style="transform: scale(1.3); margin-right: 10px;">
                                    <label class="form-check-label fw-bold text-warning pt-1" for="switchNew">Đánh dấu là Món Mới</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold"><i class="bi bi-save me-1"></i> Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>