@model CMS.Data.Entities.Product
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm Món ăn";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-egg-fried me-2"></i>Thêm Món Mới Vào Thực Đơn</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Tên món ăn <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required placeholder="VD: Lẩu Thái Tomyum..." />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Danh mục</label>
                                <select asp-for="CategoryProductId" asp-items="ViewBag.CategoryList" class="form-select" required>
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                <input asp-for="Price" type="number" class="form-control text-danger fw-bold" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Số lượng tồn kho</label>
                                <input asp-for="StockQuantity" type="number" class="form-control" value="100" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark">Chọn ảnh sản phẩm</label>
                                <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark">Mô tả món ăn</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nguyên liệu, cách chế biến..."></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Lưu món ăn</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>