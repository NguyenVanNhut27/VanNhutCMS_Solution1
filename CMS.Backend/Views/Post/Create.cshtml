@model CMS.Data.Entities.Post
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm bài viết";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-0"><i class="bi bi-pencil-square me-2"></i>Thêm bài viết mới</h4>
            <p class="text-muted mb-0 small">Soạn thảo nội dung bài viết cho hệ thống</p>
        </div>
        <a asp-action="Index" class="btn btn-light border rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="row g-4">
                    <div class="col-md-12">
                        <label class="fw-bold form-label text-dark">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề hấp dẫn..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="fw-bold form-label text-dark">Tóm tắt <span class="text-danger">*</span></label>
                        <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Đoạn mô tả ngắn hiển thị ngoài trang chủ..."></textarea>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="fw-bold form-label text-dark">Ảnh đại diện</label>
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Nên chọn ảnh có tỷ lệ 16:9 để hiển thị đẹp nhất.</small>
                    </div>

                    <div class="col-md-12">
                        <label class="fw-bold form-label text-dark">Nội dung chi tiết <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" id="editor" class="form-control"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-send me-1"></i> Đăng bài</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.ckeditor.com/ckeditor5/36.0.1/classic/ckeditor.js"></script>
<script>
    ClassicEditor
        .create(document.querySelector('#editor'))
        .catch(error => {
            console.error(error);
        });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}