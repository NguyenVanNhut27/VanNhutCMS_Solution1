@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Bài viết";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-0"><i class="bi bi-newspaper me-2"></i>Quản lý Bài viết</h4>
            <p class="text-muted mb-0 small">Hiển thị danh sách các bài viết trên hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Viết bài mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 py-5 text-center">
            <div class="card-body">
                <i class="bi bi-journal-x text-muted" style="font-size: 4rem;"></i>
                <h5 class="mt-3 text-muted">Chưa có bài viết nào</h5>
                <p class="text-muted small">Hãy tạo bài viết đầu tiên để làm phong phú nội dung trang web của bạn.</p>
                <a asp-action="Create" class="btn btn-outline-primary mt-2">Bắt đầu ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden post-card">

                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top object-fit-cover" alt="@item.Title" style="height: 200px;">
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex justify-content-center align-items-center" style="height: 200px;">
                                    <i class="bi bi-image text-secondary fs-1"></i>
                                </div>
                            }
                            <span class="badge bg-dark position-absolute top-0 end-0 m-3 bg-opacity-75 rounded-pill">
                                @item.CreatedDate.ToString("dd/MMM")
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark text-truncate" title="@item.Title">
                                @item.Title
                            </h5>

                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Summary
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <small class="text-muted fw-medium">
                                    <i class="bi bi-person-circle me-1"></i> Admin
                                </small>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary" title="Sửa bài viết">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger" title="Xóa bài viết" onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .post-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .post-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .object-fit-cover {
        object-fit: cover;
    }
</style>