@model CMS.Data.Entities.DiningTable
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm Bàn ăn";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-plus-square-dotted me-2"></i>Thêm Bàn Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-dark">Tên / Số bàn <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required placeholder="VD: Bàn 01, Bàn VIP 2..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark">Số chỗ ngồi</label>
                                <input asp-for="Capacity" type="number" class="form-control" value="4" min="1" />
                            </div>
                            <input type="hidden" asp-for="Status" value="0" />
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Lưu bàn</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>