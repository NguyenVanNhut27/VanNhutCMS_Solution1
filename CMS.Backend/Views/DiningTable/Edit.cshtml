@model CMS.Data.Entities.DiningTable
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa thông tin Bàn";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Thông Tin Bàn</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Tên / Số bàn <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Số chỗ ngồi</label>
                                <input asp-for="Capacity" type="number" class="form-control" min="1" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark">Trạng thái hiện tại:</label>
                                <select asp-for="Status" class="form-select border-warning">
                                    <option value="0">Bàn trống (Available)</option>
                                    <option value="1">Đang có khách (Occupied)</option>
                                    <option value="2">Đã đặt trước (Reserved)</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold"><i class="bi bi-save me-1"></i> Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>