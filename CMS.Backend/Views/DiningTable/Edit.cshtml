@model CMS.Data.Entities.DiningTable
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa bàn";
}

<div class="container-fluid px-4 mt-4">
    <div class="mb-4">
        <h2 class="h3 mb-1 text-gray-800 fw-bold">Chỉnh Sửa Thông Tin Bàn</h2>
        <p class="text-muted mb-0">Cập nhật tên và sức chứa của bàn ăn</p>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="max-width: 600px;">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-secondary">Tên Bàn</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><rect x="3" y="8" width="18" height="8" rx="2" ry="2"></rect><line x1="7" y1="16" x2="7" y2="22"></line><line x1="17" y1="16" x2="17" y2="22"></line><line x1="3" y1="12" x2="1" y2="12"></line><line x1="23" y1="12" x2="21" y2="12"></line></svg>
                        </span>
                        <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="VD: Bàn 1, VIP 1..." required />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Capacity" class="form-label fw-semibold text-secondary">Số chỗ ngồi (Sức chứa)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                        </span>
                        <input asp-for="Capacity" type="number" min="1" class="form-control border-start-0 ps-0" required />
                    </div>
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-2 border-top">
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-medium shadow-sm">Lưu Thay Đổi</button>
                    <a asp-action="Index" class="btn btn-light border rounded-3 px-4 fw-medium text-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}