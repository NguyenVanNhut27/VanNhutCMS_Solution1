@model IEnumerable<CMS.Data.Entities.Promotion>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Khuyến mãi";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0">Danh Sách Khuyến Mãi</h2>
            <p class="text-muted mb-0">Quản lý các chương trình ưu đãi và banner quảng cáo</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm Chương Trình
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Banner</th>
                        <th>Tên Chương Trình</th>
                        <th>Mức Giảm</th>
                        <th>Thời Gian Áp Dụng</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="Banner" class="rounded-3" style="width: 80px; height: 45px; object-fit: cover; border: 1px solid #eee;">
                                    }
                                    else
                                    {
                                        <div class="rounded-3 bg-light d-flex align-items-center justify-content-center text-muted" style="width: 80px; height: 45px; border: 1px dashed #ccc; font-size: 0.8rem;">
                                            No Image
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@item.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 200px;">@item.Content</div>
                                </td>
                                <td>
                                    <span class="badge bg-danger px-3 py-2 rounded-pill fs-6">
                                        <i class="bi bi-tags me-1"></i> -@item.DiscountPercent %
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-dark">
                                        <strong>Từ:</strong> @item.StartDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    <div class="small text-dark mt-1">
                                        <strong>Đến:</strong> @item.EndDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Đã tắt</span>
                                    }
                                    else if (item.EndDate < DateTime.Now)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Hết hạn</span>
                                    }
                                    else if (item.StartDate > DateTime.Now)
                                    {
                                        <span class="badge bg-info text-dark px-2 py-1">Sắp diễn ra</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-2 py-1">Đang diễn ra</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Bạn có chắc chắn muốn xóa chương trình này?');">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-gift fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Chưa có chương trình khuyến mãi</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>