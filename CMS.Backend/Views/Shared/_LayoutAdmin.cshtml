<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SMART POS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f7fe; /* Nền xám xanh sáng hiện đại */
        }

        /* Tùy chỉnh thanh Sidebar bên trái */
        .sidebar {
            background: linear-gradient(180deg, #111c43 0%, #0d1430 100%);
            color: #a3aed1;
            box-shadow: 4px 0 24px rgba(0,0,0,0.06);
            z-index: 1000;
        }

        .sidebar-brand {
            padding: 1.5rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            font-weight: 800;
            letter-spacing: 1.5px;
            color: #ffffff;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Khung thông tin User xịn xò */
        .sidebar-user {
            padding: 1.5rem;
            background: rgba(255,255,255,0.02);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            margin: 10px;
            border-radius: 16px;
            text-align: center;
        }

            .sidebar-user .avatar {
                width: 64px;
                height: 64px;
                background: linear-gradient(135deg, #0d6efd, #0dcaf0);
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
                margin: 0 auto 12px;
                box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
            }

        .nav-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 700;
            color: #5b6790;
            padding: 1.5rem 1.5rem 0.5rem;
            letter-spacing: 1px;
        }

        /* Tùy chỉnh nút Menu */
        .sidebar a.nav-link-custom {
            color: #a3aed1;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 0.8rem 1.5rem;
            margin: 4px 12px;
            border-radius: 10px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-weight: 500;
            font-size: 0.95rem;
        }

            .sidebar a.nav-link-custom i {
                font-size: 1.25rem;
                margin-right: 12px;
                width: 24px;
                text-align: center;
                transition: transform 0.3s ease;
            }

            /* Hiệu ứng Hover nổi bật */
            .sidebar a.nav-link-custom:hover {
                color: #ffffff;
                background-color: rgba(255,255,255,0.05);
                transform: translateX(5px);
            }

                .sidebar a.nav-link-custom:hover i {
                    transform: scale(1.1);
                    color: #0dcaf0;
                }

            /* Menu đang được chọn */
            .sidebar a.nav-link-custom.active {
                color: #ffffff;
                background: linear-gradient(90deg, rgba(13, 110, 253, 0.9) 0%, rgba(13, 110, 253, 0.7) 100%);
                box-shadow: 0 4px 15px rgba(13, 110, 253, 0.2);
            }

        /* Thanh cuộn tàng hình cho menu */
        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #2d375c;
            border-radius: 10px;
        }

            .sidebar::-webkit-scrollbar-thumb:hover {
                background: #3f4b7a;
            }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="d-flex">
            <nav class="sidebar d-flex flex-column sticky-top flex-shrink-0" style="width: 260px; height: 100vh; overflow-y: auto;">

                <div class="sidebar-brand fs-5">
                    <i class="bi bi-shop text-warning me-2"></i>SMART POS
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="sidebar-user text-center">
                        <div class="avatar">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="fw-bold text-white mb-1 fs-6">@User.FindFirst("FullName")?.Value</div>
                        <div class="small text-info mb-3 fw-bold bg-info bg-opacity-10 py-1 px-2 rounded-pill d-inline-block">
                            <i class="bi bi-shield-check me-1"></i> @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </div>
                        <br />
                        <a class="btn btn-outline-danger btn-sm rounded-pill px-4 shadow-sm" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </a>
                    </div>
                }

                <div class="mt-2 pb-5 d-flex flex-column">

                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <div class="nav-title">Tổng quan</div>
                        <a asp-controller="Home" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-bar-chart-line"></i> Dashboard / Doanh thu
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier") || User.IsInRole("Waiter"))
                    {
                        <div class="nav-title">Nghiệp vụ Bán Hàng</div>
                        <a asp-controller="Order" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-grid-3x3-gap"></i> Bàn ăn & Đơn hàng
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Chef"))
                    {
                        <div class="nav-title">Khu vực Bếp</div>
                        <a asp-controller="Order" asp-action="KitchenQueue" class="nav-link-custom text-warning">
                            <i class="bi bi-fire"></i> Màn hình Bếp (KDS)
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <a asp-controller="Customer" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-people"></i> Khách hàng (Tích điểm)
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="nav-title">Cơ sở vật chất</div>
                        <a asp-controller="DiningTable" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-table"></i> Quản lý Sơ đồ Bàn
                        </a>

                        <div class="nav-title">Quản lý Thực Đơn</div>
                        <a asp-controller="CategoryProduct" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-tags"></i> Danh mục món ăn
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-egg-fried"></i> Danh sách Món ăn
                        </a>
                        <a asp-controller="Promotion" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-megaphone"></i> Khuyến mãi
                        </a>

                        <div class="nav-title">Quản lý Kho hàng</div>
                        <a asp-controller="Supplier" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-truck"></i> Nhà cung cấp
                        </a>
                        <a asp-controller="Inventory" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-box-seam"></i> Nhập kho
                        </a>

                        <div class="nav-title">Hệ thống & Nội dung</div>
                        <a asp-controller="User" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-person-badge"></i> Quản lý Nhân sự
                        </a>
                        <a asp-controller="Post" asp-action="Index" class="nav-link-custom">
                            <i class="bi bi-newspaper"></i> Quản lý Bài viết
                        </a>
                    }
                </div>
            </nav>

            <main class="flex-grow-1 p-4" style="min-width: 0; min-height: 100vh;">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // Lấy URL hiện tại
            var currentUrl = window.location.pathname.toLowerCase();

            // Tìm thẻ a có href khớp với URL và thêm class 'active'
            $('.nav-link-custom').each(function () {
                var href = $(this).attr('href').toLowerCase();
                if (currentUrl === href || (currentUrl.startsWith(href) && href !== '/')) {
                    $(this).addClass('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>