@model CMS.Data.Entities.Order
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Tạo Đơn Hàng Mới";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-cart-plus me-2"></i>Tạo Hóa Đơn Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Loại đơn hàng</label>
                                <select asp-for="OrderType" class="form-select border-primary shadow-sm">
                                    <option value="DineIn">🍽️ Ăn tại quán</option>
                                    <option value="Takeaway">🛍️ Mang đi (Takeaway)</option>
                                    <option value="Delivery">🛵 Giao hàng (Delivery)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark d-flex justify-content-between">
                                    Khách hàng (Tìm kiếm)
                                </label>
                                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select select2-search" data-placeholder="🔍 Gõ tên hoặc SĐT để tìm...">
                                    <option value="">-- Khách vãng lai (Không tích điểm) --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Chọn Bàn / Khu vực</label>
                                <select asp-for="DiningTableId" asp-items="ViewBag.DiningTables" class="form-select select2-search" data-placeholder="🔍 Nhập số bàn (VD: Bàn 5)...">
                                    <option value="">-- Đơn mang đi / Không cần bàn --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Số lượng khách</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-light"><i class="bi bi-people"></i></span>
                                    <input asp-for="GuestCount" type="number" class="form-control" min="1" value="1" />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold text-dark">Ghi chú đơn hàng</label>
                                <textarea asp-for="Note" class="form-control shadow-sm" rows="2" placeholder="Ghi chú lưu ý cho bếp (Không hành, ít cay...)"></textarea>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 rounded-3 small mt-4 shadow-sm">
                            <i class="bi bi-info-circle-fill me-1"></i> Hóa đơn sẽ được tạo với trạng thái <strong>Đang phục vụ</strong>. Thu ngân vui lòng kiểm tra kỹ thông tin bàn.
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-3">
                            <a asp-action="Index" class="btn btn-light border px-4 shadow-sm">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> Bắt đầu gọi món
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // Áp dụng Select2 cho tất cả thẻ <select> có class 'select2-search'
            $('.select2-search').select2({
                theme: 'bootstrap-5', // Sử dụng theme cho hợp với Bootstrap hiện tại
                width: '100%',
                allowClear: true // Cho phép bấm nút (x) để xóa lựa chọn
            });
        });
    </script>
}