@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0">Danh Sách Đơn Hàng</h2>
            <p class="text-muted mb-0">Quản lý các bàn đang phục vụ và hóa đơn</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Tạo Đơn Mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3">Mã Đơn</th>
                        <th class="py-3">Phân loại & Khách hàng</th>
                        <th class="py-3">Giờ vào</th>
                        <th class="py-3">Tổng tiền</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="text-end pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 fw-semibold text-muted">#ORD-@item.Id</td>

                                <td>
                                    <div class="fw-bold text-dark fs-6 d-flex align-items-center mb-1">
                                        @if (item.OrderType == "Takeaway")
                                        {
                                            <span class="badge bg-info text-dark me-2 px-2 py-1"><i class="bi bi-bag"></i> Mang đi</span>
                                        }
                                        else if (item.OrderType == "Delivery")
                                        {
                                            <span class="badge bg-primary text-white me-2 px-2 py-1"><i class="bi bi-motorcycle"></i> Giao hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white me-2 px-2 py-1"><i class="bi bi-shop"></i> Tại quán</span>
                                        }

                                        @if (item.DiningTable != null)
                                        {
                                            <span class="text-primary">@item.DiningTable.Name</span>
                                        }
                                    </div>

                                    <div class="small text-muted">
                                        <span class="me-3">
                                            <i class="bi bi-person text-secondary"></i> @(item.Customer?.FullName ?? "Khách vãng lai")
                                        </span>

                                        @if (item.GuestCount > 1)
                                        {
                                            <span class="me-3">
                                                <i class="bi bi-people text-secondary"></i> @item.GuestCount người
                                            </span>
                                        }

                                        @if (!string.IsNullOrEmpty(item.Note))
                                        {
                                            <span class="text-danger fst-italic">
                                                <i class="bi bi-exclamation-circle"></i> @item.Note
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td class="text-muted">
                                    <i class="bi bi-clock me-1"></i> @item.OrderTime.ToString("HH:mm - dd/MM")
                                </td>

                                <td class="fw-bold text-danger fs-6">@item.TotalAmount.ToString("N0") đ</td>

                                <td>
                                    @if (item.Status == CMS.Data.Entities.OrderStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                            <i class="bi bi-hourglass-split me-1"></i> Đang phục vụ
                                        </span>
                                    }
                                    else if (item.Status == CMS.Data.Entities.OrderStatus.Completed)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark bg-opacity-50 px-3 py-2 rounded-pill">Đã hủy</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">
                                        <i class="bi bi-list-check"></i> Chi tiết
                                    </a>
                                    @if (item.Status == CMS.Data.Entities.OrderStatus.Pending)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-circle ms-1 shadow-sm" title="Chỉnh sửa đơn">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Chưa có đơn hàng nào</h5>
                                <p>Nhà hàng hiện tại đang trống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>