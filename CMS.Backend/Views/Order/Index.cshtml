@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0">Danh Sách Đơn Hàng</h2>
            <p class="text-muted mb-0">Quản lý các bàn đang phục vụ và đơn hàng</p>
        </div>
        <button class="btn btn-primary shadow-sm" disabled>
            <i class="bi bi-plus-circle"></i> Mở Bàn Mới (Sắp ra mắt)
        </button>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Mã Đơn</th>
                        <th>Thông tin Bàn / Khách</th>
                        <th>Giờ vào</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">
                                        <i class="bi bi-shop text-primary me-1"></i>
                                        @(item.DiningTable?.Name ?? "Đơn Mang Đi (Takeaway)")
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-person me-1"></i>
                                        @(item.Customer?.FullName ?? "Khách vãng lai")
                                    </div>
                                </td>
                                <td class="text-muted">
                                    <i class="bi bi-clock me-1"></i> @item.OrderTime.ToString("HH:mm - dd/MM")
                                </td>
                                <td class="fw-bold text-danger">@item.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    @if (item.Status == CMS.Data.Entities.OrderStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                            <i class="bi bi-hourglass-split me-1"></i> Đang phục vụ
                                        </span>
                                    }
                                    else if (item.Status == CMS.Data.Entities.OrderStatus.Completed)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Đã hủy</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-list-check"></i> Xem & Gọi món
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Chưa có đơn hàng nào</h5>
                                <p>Nhà hàng hiện tại đang trống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>