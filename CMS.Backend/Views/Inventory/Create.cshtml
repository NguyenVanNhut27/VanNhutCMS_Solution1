@model CMS.Data.Entities.InventoryReceipt
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Tạo Phiếu Nhập Kho";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-truck me-2"></i>Khởi tạo Phiếu Nhập Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3 small"></div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Chọn Nhà Cung Cấp <span class="text-danger">*</span></label>
                            <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select border-primary" required>
                                <option value="">-- Chọn Đơn vị cung cấp --</option>
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Ghi chú (Tên tài xế, Biển số xe...)</label>
                            <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú thêm..."></textarea>
                            <span asp-validation-for="Note" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="alert alert-info border-0 rounded-3 small">
                            <i class="bi bi-info-circle me-1"></i> Sau khi tạo phiếu, bạn sẽ được chuyển sang màn hình chi tiết để liệt kê các mặt hàng được nhập.
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="bi bi-arrow-right-circle me-1"></i> Tạo Phiếu & Bắt đầu nhập
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>