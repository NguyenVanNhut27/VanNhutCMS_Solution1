@model IEnumerable<CMS.Data.Entities.InventoryReceipt>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Lịch sử Nhập Kho";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0"><i class="bi bi-box-seam text-primary me-2"></i>Quản Lý Nhập Kho</h2>
            <p class="text-muted mb-0">Theo dõi lịch sử nhập hàng từ Nhà cung cấp</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Tạo Phiếu Nhập Mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Mã Phiếu</th>
                        <th>Thời gian nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Tổng tiền nhập</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 fw-bold text-primary">#RC-@item.Id</td>
                                
                                <td class="text-muted">
                                    <i class="bi bi-calendar-check me-1"></i> @item.ReceiptDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                               
                                <td class="fw-bold text-dark">
                                    <i class="bi bi-truck text-secondary me-1"></i> @(item.Supplier?.Name ?? "N/A")
                                </td>
                                <td class="fw-bold text-danger">
                                    @item.TotalAmount.ToString("N0") đ
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                        <i class="bi bi-list-check"></i> Nhập hàng
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 ms-1" onclick="return confirm('Xóa phiếu này sẽ làm sai lệch lịch sử dòng tiền. Bạn chắc chắn chứ?');" title="Xóa Phiếu">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Chưa có phiếu nhập nào</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>