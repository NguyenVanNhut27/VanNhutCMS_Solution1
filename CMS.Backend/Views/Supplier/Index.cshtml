@model IEnumerable<CMS.Data.Entities.Supplier>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Nhà Cung Cấp";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0">Danh Sách Nhà Cung Cấp</h2>
            <p class="text-muted mb-0">Quản lý đối tác và nguồn nhập nguyên liệu cho nhà hàng</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm Nhà Cung Cấp
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Thông tin Đối tác</th>
                        <th>Liên hệ</th>
                        <th>Địa chỉ</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@item.Name</div>

                                    @if (!string.IsNullOrEmpty(item.ContactName))
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-person-badge text-secondary me-1"></i> @item.ContactName
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="small text-dark fw-semibold">
                                        <i class="bi bi-telephone text-success me-1"></i> @(string.IsNullOrEmpty(item.PhoneNumber) ? "Chưa cập nhật" : item.PhoneNumber)
                                    </div>

                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-envelope text-primary me-1"></i> @item.Email
                                        </div>
                                    }
                                </td>
                                <td class="text-muted text-truncate" style="max-width: 250px;">
                                    @(string.IsNullOrEmpty(item.Address) ? "Chưa cập nhật" : item.Address)
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Bạn có chắc chắn muốn xóa đối tác này khỏi hệ thống?');">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-truck fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Chưa có nhà cung cấp nào</h5>
                                <p>Hệ thống hiện tại chưa ghi nhận đối tác cung cấp nguyên liệu.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>