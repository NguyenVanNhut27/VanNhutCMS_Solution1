@model IEnumerable<CMS.Data.Entities.Customer>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0">Danh Sách Khách Hàng</h2>
            <p class="text-muted mb-0">Quản lý thông tin và điểm tích lũy thành viên</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus"></i> Thêm Khách Hàng Mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Tên Khách Hàng</th>
                        <th>Số Điện Thoại</th>
                        <th>Điểm Tích Lũy</th>
                        <th>Ngày Tham Gia</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                <td class="fw-bold text-dark">@item.FullName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                    {
                                        <a href="tel:@item.PhoneNumber" class="text-decoration-none">
                                            <i class="bi bi-telephone text-success me-1"></i> @item.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-star-fill text-danger me-1"></i> @item.RewardPoints điểm
                                    </span>
                                </td>
                                <td class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Chưa có khách hàng nào</h5>
                                <p>Hệ thống chưa ghi nhận thông tin khách hàng.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>